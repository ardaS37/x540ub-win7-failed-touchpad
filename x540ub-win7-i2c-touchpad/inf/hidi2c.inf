;/*++
;
; hidi2c.inf — backport of Microsoft's inbox Windows 8.1 "HID I2C" transport
; driver to Windows 7 x64, for ACPI\PNP0C50 (HID-over-I2C) devices.
;
; THIS INF DOES NOT INCLUDE THE DRIVER BINARIES. You need to supply, from a
; Windows 8.1 installation/ISO you are licensed for:
;   - Windows\System32\drivers\hidi2c.sys
;   - Windows\System32\drivers\mshidkmdf.sys
;   - Windows\System32\drivers\WppRecorder.sys
; placed in the same folder as this INF, then Authenticode-signed with a
; certificate trusted on the target machine (see ../docs/driver-signing.md)
; before installing. NOTE: as documented in ../docs/attempted-drivers.md,
; hidi2c.sys from Windows 8.1 (build 6.3.9600.16384) imports
; IoGetActivityIdIrp/IoSetActivityIdIrp from ntoskrnl.exe, which do not exist
; on Windows 7 — this backport alone WILL NOT WORK as-is (Code 39). It's
; included here only as a documented reference / starting point for anyone
; who wants to binary-patch those two imports out.
;
; What this INF changes vs. Microsoft's original Windows 8.1 hidi2c.inf:
;   - Added an explicit NTamd64.6.1 (Windows 7) Manufacturer/Models section
;     (the original only has a NTamd64...1 decorated section, whose exact
;     OS-version-matching semantics under Windows 7's older setupapi.dll
;     parser are not something we wanted to rely on).
;   - Removed `Include=machine.inf` / `Needs=PciD3ColdSupported` from the
;     .NT.HW section — that D3cold power-management feature section doesn't
;     exist in Windows 7's machine.inf and would hard-fail the install.
;   - Added an explicit AddService for `mshidkmdf`, including its exact
;     service parameters (Type/Start/ErrorControl/Group) read directly out
;     of a Windows 8.1 SYSTEM registry hive, since Windows 8.1 registers this
;     service via its boot-time default hive rather than any installable
;     INF, and Windows 7 has neither.
;   - Added WppRecorder.sys to CopyFiles (a plain file-presence dependency
;     of hidi2c.sys with no service of its own — see ../docs/attempted-drivers.md).
;
;--*/

[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%MSFT%
DriverVer=06/21/2006,6.3.9600.16384

[SourceDisksNames]
3426 = windows cd

[SourceDisksFiles]
hidi2c.sys      = 3426
mshidkmdf.sys   = 3426
WppRecorder.sys = 3426

[DestinationDirs]
DefaultDestDir = 12

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%MSFT%=Microsoft,NTamd64...1,NTamd64.6.1

[Microsoft.NTamd64...1]
%hidi2c.DeviceDesc%=hidi2c_Device, ACPI\PNP0C50

[Microsoft.NTamd64.6.1]
%hidi2c.DeviceDesc%=hidi2c_Device, ACPI\PNP0C50

[hidi2c_Device.NT]
CopyFiles=hidi2c_Device.CopyFiles

[hidi2c_Device.CopyFiles]
hidi2c.sys,,,0x100
mshidkmdf.sys,,,0x100
WppRecorder.sys,,,0x100

[hidi2c_Device.NT.HW]
AddReg = hidi2c_Device.Filter.AddReg, hidi2c_Device.Configuration.AddReg

[hidi2c_Device.Filter.AddReg]
HKR,,"UpperFilters",0x00010000,"mshidkmdf"

[hidi2c_Device.Configuration.AddReg]
HKR,,"EnhancedPowerManagementEnabled",0x00010001,1

[hidi2c_Device.NT.Services]
AddService = hidi2c, 0x00000002, hidi2c_Service_Inst, hidi2c_EventLog_Inst
AddService = mshidkmdf, 0x00000000, mshidkmdf_Service_Inst

[hidi2c_Service_Inst]
DisplayName    = %hidi2c.SVCDESC%
ServiceType    = 1                     ; SERVICE_KERNEL_DRIVER
StartType      = 3                     ; SERVICE_DEMAND_START
ErrorControl   = 1                     ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\hidi2c.sys
LoadOrderGroup = Extended Base

[hidi2c_EventLog_Inst]
AddReg = hidi2c_EventLog_Inst.AddReg

[hidi2c_EventLog_Inst.AddReg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\IoLogMsg.dll;%%SystemRoot%%\System32\Drivers\hidi2c.sys"
HKR,,TypesSupported,0x00010001,7

; Service parameters read from a Windows 8.1 SYSTEM hive's
; ControlSet001\Services\mshidkmdf key, verbatim.
[mshidkmdf_Service_Inst]
DisplayName    = %mshidkmdf.SVCDESC%
ServiceType    = 1                     ; SERVICE_KERNEL_DRIVER
StartType      = 3                     ; SERVICE_DEMAND_START
ErrorControl   = 0                     ; SERVICE_ERROR_IGNORE
ServiceBinary  = %12%\mshidkmdf.sys
LoadOrderGroup = Base

[Strings]
MSFT = "Microsoft"
DiskName = "HIDI2C"
hidi2c.DeviceDesc = "I2C HID Device"
hidi2c.SVCDESC = "Microsoft I2C HID Miniport Driver"
mshidkmdf.SVCDESC = "Microsoft HID Class KMDF Lower Filter Driver"

SERVICE_KERNEL_DRIVER   = 0x1
SERVICE_ERROR_IGNORE    = 0x0
SERVICE_ERROR_NORMAL    = 0x1
SERVICE_ERROR_SEVERE    = 0x2
SERVICE_ERROR_CRITICAL  = 0x3
