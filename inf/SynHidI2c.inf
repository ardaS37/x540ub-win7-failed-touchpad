;
; SynHidI2c.inf — minimal INF to bind Synaptics' "I2C Miniport" driver
; (SynHidI2c.sys) to an ACPI HID-over-I2C touchpad device on Windows 7 x64.
;
; THIS INF DOES NOT INCLUDE SynHidI2c.sys. That file is Synaptics'
; proprietary driver, part of various Synaptics touchpad driver bundles for
; I2C-HID digitizers (same situation as iaHIDI2C.inf in this folder — check
; your OEM's support downloads, or a machine's
; C:\Windows\System32\DriverStore\FileRepository\synhidi2c.inf_*\ for a
; legitimate copy + original .inf/.cat). Sign it (see
; ../docs/driver-signing.md) before installing with this INF.
;
; Replace ACPI\ELAN1200 below with your own touchpad's ACPI _HID.
;
; Verified (see ../docs/attempted-drivers.md): zero unresolved imports
; against a real Windows 7 SP1 x64 ntoskrnl.exe. Loads cleanly. Still does
; not make the touchpad work on our test unit — see
; ../docs/code12-resource-conflict.md.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %Provider%
DriverVer   = 01/01/2026,19.4.18.37

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
SynHidI2c.sys = 1

[Manufacturer]
%Provider% = Models, NTamd64

[Models.NTamd64]
%DeviceDesc% = SYNHID_Inst, ACPI\ELAN1200

[SYNHID_Inst.NT]
CopyFiles = SYNHID_Files

[SYNHID_Files]
SynHidI2c.sys

[SYNHID_Inst.NT.Services]
AddService = SynHidI2c, 0x00000002, SYNHID_Service

[SYNHID_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\SynHidI2c.sys

[Strings]
Provider    = "Synaptics"
DiskName    = "SynHidI2c Setup"
DeviceDesc  = "Synaptics(R) I2C Miniport"
ServiceName = "Synaptics(R) I2C Miniport"
